---
// Hero Section Component - Nexus Fitness Court
---

<section class="hero-section" aria-labelledby="hero-heading">
  <div class="container hero-grid">
    <!-- Left Column: Content & Conversion Hooks -->
    <div class="hero-content">
      <div class="badge-nexus badge-nexus-pulse hero-badge">
        BESA ROAD &bull; NAGPUR (NEAR BESA MASJID)
      </div>

      <h1 id="hero-heading" class="hero-title">
        ELEVATE YOUR STRENGTH. <span class="text-nexus">REDEFINE YOUR LIMITS.</span>
      </h1>

      <p class="hero-subhead">
        Welcome to <strong>Nexus Fitness Court</strong>. Experience Besa's premier unisex fitness hub featuring commercial Gymquip plate-loaded machines, dedicated free weight arena, cardio wing, and science-backed personal coaching.
      </p>

      <div class="hero-actions">
        <a href="#book-call" class="btn-primary hero-btn-main">
          <span>Claim 1-Day Free Trial</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
        <a href="#facility" class="btn-ghost hero-btn-sec">
          <span>Tour Our Gym Floor</span>
        </a>
      </div>

      <!-- Social Proof / Local Gym Credibility Bar -->
      <div class="hero-social-proof">
        <div class="avatar-group" aria-hidden="true">
          <div class="avatar-bubble av-1">NF</div>
          <div class="avatar-bubble av-2">BS</div>
          <div class="avatar-bubble av-3">NG</div>
          <div class="avatar-bubble av-4">4.8★</div>
        </div>
        <div class="proof-info">
          <div class="stars-row" aria-label="4.8 out of 5 stars">
            <span class="star">★</span>
            <span class="star">★</span>
            <span class="star">★</span>
            <span class="star">★</span>
            <span class="star">★</span>
            <span class="rating-num">4.8 / 5.0 Google Rating</span>
          </div>
          <p class="proof-text">Trusted by <strong>400+ active members</strong> across Besa, Manish Nagar & South Nagpur</p>
        </div>
      </div>
    </div>

    <!-- Right Column: Visual Hero Card Featuring Real Gym Floor -->
    <div class="hero-visual-wrapper">
      <div class="hero-card glass-card glass-card-glow">
        <div class="hero-image-box">
          <img 
            src="/images/nexus-gym-floor.jpg" 
            alt="Nexus Fitness Court Gym Floor with Gymquip Stations, Besa Nagpur" 
            width="600" 
            height="450" 
            loading="eager" 
            fetchpriority="high"
            class="hero-img"
          />
          <div class="hero-img-gradient"></div>
          <div class="gym-live-chip">LIVE FACILITY PHOTO</div>
        </div>

        <!-- Floating Nexus Badge -->
        <div class="hero-card-banner">
          <div class="banner-pill">
            <span class="banner-dot"></span>
            <div>
              <span class="banner-sub">Nexus Training Arena</span>
              <h3 class="banner-title">Gymquip Machines & Cable Zone</h3>
            </div>
          </div>
          <a href="#facility" class="banner-action" aria-label="Explore gym equipment">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Accent glowing backdrop element in Volt Gold -->
      <div class="glow-orb" aria-hidden="true"></div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    padding-top: 4.5rem;
    padding-bottom: 5.5rem;
    position: relative;
    overflow: hidden;
  }
  @media (min-width: 1024px) {
    .hero-section {
      padding-top: 5.5rem;
      padding-bottom: 7rem;
    }
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3.5rem;
    align-items: center;
  }
  @media (min-width: 960px) {
    .hero-grid {
      grid-template-columns: 1.15fr 0.95fr;
      gap: 4rem;
    }
  }

  .hero-badge {
    margin-bottom: 1.5rem;
  }
  .hero-title {
    font-size: 2.75rem;
    line-height: 1.05;
    letter-spacing: -0.04em;
    margin-bottom: 1.5rem;
  }
  @media (min-width: 768px) {
    .hero-title {
      font-size: 3.8rem;
    }
  }
  @media (min-width: 1200px) {
    .hero-title {
      font-size: 4.4rem;
    }
  }

  .hero-subhead {
    font-size: 1.1rem;
    line-height: 1.7;
    color: var(--text-secondary);
    max-width: 580px;
    margin-bottom: 2.5rem;
  }
  .hero-subhead strong {
    color: #ffffff;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1.15rem;
    margin-bottom: 3rem;
  }
  .hero-btn-main {
    padding: 1rem 2.25rem;
    font-size: 0.92rem;
  }
  .hero-btn-sec {
    padding: 1rem 2rem;
  }

  /* Social Proof Bar */
  .hero-social-proof {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-subtle);
  }
  .avatar-group {
    display: flex;
    align-items: center;
  }
  .avatar-bubble {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 2px solid var(--bg-canvas);
    margin-left: -10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-heading);
    font-size: 0.72rem;
    font-weight: 700;
    color: #ffffff;
    background: #1e293b;
  }
  .avatar-bubble:first-child {
    margin-left: 0;
    background: #eab308;
    color: #0b0c10;
  }
  .avatar-bubble.av-2 { background: #334155; }
  .avatar-bubble.av-3 { background: #0f172a; }
  .avatar-bubble.av-4 { 
    background: #ca8a04; 
    color: #ffffff;
  }

  .proof-info {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .stars-row {
    display: flex;
    align-items: center;
    gap: 0.2rem;
    color: #facc15;
    font-size: 0.95rem;
  }
  .rating-num {
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 700;
    color: #ffffff;
    margin-left: 0.4rem;
  }
  .proof-text {
    font-size: 0.85rem;
    color: var(--text-secondary);
  }
  .proof-text strong {
    color: #ffffff;
  }

  /* Hero Visual Card */
  .hero-visual-wrapper {
    position: relative;
    display: flex;
    justify-content: center;
  }
  .hero-card {
    width: 100%;
    max-width: 540px;
    background: var(--bg-surface);
    border-radius: var(--radius-xl);
    border: 1px solid var(--border-nexus);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.8), 0 0 40px rgba(234, 179, 8, 0.18);
    position: relative;
    z-index: 2;
  }
  .hero-image-box {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-xl) var(--radius-xl) 0 0;
    aspect-ratio: 4 / 3.2;
  }
  .hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .hero-card:hover .hero-img {
    transform: scale(1.04);
  }
  .hero-img-gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, var(--bg-surface) 0%, transparent 60%);
  }

  .gym-live-chip {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: rgba(7, 8, 11, 0.88);
    border: 1px solid var(--border-nexus);
    color: var(--primary);
    font-family: var(--font-heading);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    padding: 0.3rem 0.75rem;
    border-radius: var(--radius-pill);
    backdrop-filter: blur(8px);
  }

  .hero-card-banner {
    padding: 1.25rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: var(--bg-surface);
  }
  .banner-pill {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }
  .banner-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: var(--primary);
    box-shadow: 0 0 12px var(--primary);
    animation: pulse-dot 1.5s infinite;
  }
  .banner-sub {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-dim);
    font-family: var(--font-heading);
    font-weight: 700;
  }
  .banner-title {
    font-size: 1.05rem;
    color: #ffffff;
    margin-top: 0.1rem;
  }
  .banner-action {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--primary);
    color: #0b0c10;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }
  .banner-action:hover {
    transform: scale(1.1);
    box-shadow: 0 0 20px var(--primary);
  }

  /* Subtle ambient orb in Volt Gold */
  .glow-orb {
    position: absolute;
    width: 320px;
    height: 320px;
    background: radial-gradient(circle, rgba(234, 179, 8, 0.22) 0%, transparent 70%);
    top: 20%;
    right: -10%;
    filter: blur(50px);
    z-index: 1;
    pointer-events: none;
  }
</style>
