---
// Floating WhatsApp Popup Component - Nexus Fitness Court
const phoneNumber = "918149393881";
const defaultMessage = encodeURIComponent("Hi Nexus Fitness Court team, I am interested in joining Nexus Fitness Court on Besa Road, Nagpur. Can I get more details about membership plans and the 1-day free trial pass?");
const whatsappUrl = `https://wa.me/${phoneNumber}?text=${defaultMessage}`;
---

<div class="whatsapp-float-container" id="whatsappContainer">
  <!-- Interactive Chat Prompt Bubble / Tooltip -->
  <div class="whatsapp-chat-bubble" id="whatsappBubble">
    <button class="bubble-close-btn" id="closeBubbleBtn" aria-label="Close message">&times;</button>
    <div class="bubble-header">
      <div class="coach-avatar">
        <img 
          src="/favicon.svg" 
          alt="Nexus Fitness Court Support" 
          width="36" 
          height="36" 
          class="coach-avatar-img"
        />
        <span class="online-indicator"></span>
      </div>
      <div class="coach-details">
        <span class="coach-name">Nexus Fitness Court</span>
        <span class="coach-status">Online &bull; Besa, Nagpur</span>
      </div>
    </div>
    <div class="bubble-body">
      <p class="bubble-text">
        Hey! Have questions about memberships, Gymquip machines, or our free trial pass? Chat with us directly on WhatsApp!
      </p>
    </div>
    <a 
      href={whatsappUrl} 
      target="_blank" 
      rel="noopener noreferrer" 
      class="bubble-cta-btn"
      aria-label="Start WhatsApp conversation with Nexus Fitness Court"
    >
      <span>Start Chat on WhatsApp</span>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
        <path d="M12.031 0C5.385 0 0 5.385 0 12.031c0 2.115.553 4.178 1.603 5.996L.062 24l6.155-1.614a11.96 11.96 0 0 0 5.814 1.493h.005c6.645 0 12.03-5.385 12.03-12.03A12.016 12.016 0 0 0 12.031 0zm0 22.016h-.004a9.98 9.98 0 0 1-5.093-1.396l-.365-.217-3.785.993 1.01-3.69-.238-.379a9.986 9.986 0 0 1-1.536-5.296c0-5.526 4.495-10.021 10.025-10.021a9.96 9.96 0 0 1 7.085 2.936 9.96 9.96 0 0 1 2.935 7.085c0 5.526-4.495 10.021-10.025 10.021z"/>
      </svg>
    </a>
  </div>

  <!-- Floating Button -->
  <a 
    href={whatsappUrl} 
    target="_blank" 
    rel="noopener noreferrer" 
    class="whatsapp-floating-btn" 
    id="whatsappMainBtn"
    aria-label="Chat on WhatsApp with Nexus Fitness Court at +91 81493 93881"
  >
    <!-- Pulse Ripple Effect -->
    <span class="btn-ripple"></span>
    
    <!-- WhatsApp SVG Icon -->
    <svg class="whatsapp-icon" width="32" height="32" viewBox="0 0 24 24" fill="#ffffff">
      <path d="M12.031 0C5.385 0 0 5.385 0 12.031c0 2.115.553 4.178 1.603 5.996L.062 24l6.155-1.614a11.96 11.96 0 0 0 5.814 1.493h.005c6.645 0 12.03-5.385 12.03-12.03A12.016 12.016 0 0 0 12.031 0zm0 22.016h-.004a9.98 9.98 0 0 1-5.093-1.396l-.365-.217-3.785.993 1.01-3.69-.238-.379a9.986 9.986 0 0 1-1.536-5.296c0-5.526 4.495-10.021 10.025-10.021a9.96 9.96 0 0 1 7.085 2.936 9.96 9.96 0 0 1 2.935 7.085c0 5.526-4.495 10.021-10.025 10.021z"/>
    </svg>

    <!-- Notification Counter Pill -->
    <span class="notification-dot" aria-label="1 new message">1</span>
  </a>
</div>

<script>
  const closeBtn = document.getElementById('closeBubbleBtn');
  const bubble = document.getElementById('whatsappBubble');

  if (closeBtn && bubble) {
    closeBtn.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      bubble.classList.add('is-hidden');
    });
  }

  // Auto show bubble after 2.5 seconds on first load
  setTimeout(() => {
    if (bubble && !bubble.classList.contains('is-hidden')) {
      bubble.classList.add('is-visible');
    }
  }, 2500);
</script>

<style>
  .whatsapp-float-container {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 9999;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 12px;
    font-family: var(--font-body);
  }
  @media (max-width: 480px) {
    .whatsapp-float-container {
      bottom: 18px;
      right: 18px;
    }
  }

  /* Floating WhatsApp Round Button */
  .whatsapp-floating-btn {
    position: relative;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: linear-gradient(135deg, #25D366 0%, #128C7E 100%);
    box-shadow: 0 8px 24px rgba(37, 211, 102, 0.45), 0 4px 10px rgba(0, 0, 0, 0.5);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s ease;
    text-decoration: none;
  }
  @media (max-width: 480px) {
    .whatsapp-floating-btn {
      width: 54px;
      height: 54px;
    }
    .whatsapp-floating-btn .whatsapp-icon {
      width: 28px;
      height: 28px;
    }
  }

  .whatsapp-floating-btn:hover {
    transform: scale(1.1) translateY(-2px);
    box-shadow: 0 12px 30px rgba(37, 211, 102, 0.65), 0 6px 14px rgba(0, 0, 0, 0.6);
  }

  .whatsapp-floating-btn:active {
    transform: scale(0.96);
  }

  /* Continuous gentle pulsing ripple */
  .btn-ripple {
    position: absolute;
    inset: -6px;
    border-radius: 50%;
    border: 2px solid rgba(37, 211, 102, 0.6);
    animation: pulse-ring 2.5s infinite;
    pointer-events: none;
  }

  @keyframes pulse-ring {
    0% {
      transform: scale(0.95);
      opacity: 0.8;
    }
    50% {
      transform: scale(1.2);
      opacity: 0;
    }
    100% {
      transform: scale(1.2);
      opacity: 0;
    }
  }

  /* Notification Pill */
  .notification-dot {
    position: absolute;
    top: -2px;
    right: -2px;
    background: #eab308;
    color: #0b0c10;
    font-family: var(--font-heading);
    font-size: 0.72rem;
    font-weight: 800;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px solid #07080b;
    box-shadow: 0 0 8px rgba(234, 179, 8, 0.6);
  }

  /* Interactive Chat Bubble Card */
  .whatsapp-chat-bubble {
    width: 290px;
    background: #12141c;
    border: 1px solid rgba(37, 211, 102, 0.35);
    border-radius: 16px;
    padding: 1rem;
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.75), 0 0 25px rgba(37, 211, 102, 0.15);
    position: relative;
    opacity: 0;
    transform: translateY(12px) scale(0.95);
    transition: opacity 0.3s ease, transform 0.3s ease;
    pointer-events: none;
  }
  @media (max-width: 480px) {
    .whatsapp-chat-bubble {
      width: calc(100vw - 48px);
      max-width: 310px;
    }
  }

  .whatsapp-chat-bubble.is-visible {
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: auto;
  }

  .whatsapp-chat-bubble.is-hidden {
    display: none !important;
  }

  .bubble-close-btn {
    position: absolute;
    top: 8px;
    right: 10px;
    background: transparent;
    border: none;
    color: #6b7280;
    font-size: 1.25rem;
    cursor: pointer;
    line-height: 1;
    padding: 2px 6px;
    border-radius: 4px;
    transition: color 0.15s;
  }
  .bubble-close-btn:hover {
    color: #ffffff;
  }

  .bubble-header {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 0.65rem;
  }
  .coach-avatar {
    position: relative;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    overflow: visible;
  }
  .coach-avatar-img {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid #25D366;
    background: #000;
  }
  .online-indicator {
    position: absolute;
    bottom: -1px;
    right: -1px;
    width: 9px;
    height: 9px;
    background: #25D366;
    border-radius: 50%;
    border: 1.5px solid #12141c;
  }

  .coach-details {
    display: flex;
    flex-direction: column;
  }
  .coach-name {
    font-family: var(--font-heading);
    font-size: 0.88rem;
    font-weight: 700;
    color: #ffffff;
  }
  .coach-status {
    font-size: 0.72rem;
    color: #25D366;
    font-weight: 600;
  }

  .bubble-body {
    background: #171b26;
    padding: 0.65rem 0.85rem;
    border-radius: 10px;
    margin-bottom: 0.75rem;
    border-left: 3px solid #25D366;
  }
  .bubble-text {
    font-size: 0.8rem;
    color: #e5e7eb;
    line-height: 1.45;
  }

  .bubble-cta-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    background: #25D366;
    color: #050608;
    padding: 0.55rem 0.85rem;
    border-radius: 9999px;
    font-family: var(--font-heading);
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    text-decoration: none;
    transition: background 0.2s ease, transform 0.2s ease;
  }
  .bubble-cta-btn:hover {
    background: #22bf5b;
    transform: translateY(-1px);
  }
</style>
