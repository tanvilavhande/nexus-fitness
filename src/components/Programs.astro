---
// Programs & Coaching Tiers Component - Nexus Fitness Court
---

<section id="programs" class="programs-section" aria-labelledby="programs-heading">
  <div class="container">
    <div class="programs-header text-center">
      <div class="badge-nexus">
        NEXUS TRAINING PROTOCOLS & TIERS
      </div>
      <h2 id="programs-heading" class="programs-title">
        BUILT FOR SERIOUS <span class="text-nexus">TRANSFORMATION.</span>
      </h2>
      <p class="programs-sub">
        Choose the program designed for your current fitness level. Whether you are aiming for fat loss, muscle building, or general everyday athleticism in Besa, Nagpur.
      </p>
    </div>

    <div class="programs-grid">
      <!-- Tier 1 -->
      <article class="program-card glass-card">
        <div class="program-tier-badge">IN-PERSON PT</div>
        <div class="program-top">
          <span class="program-tag">1-ON-1 COACHING</span>
          <h3 class="program-name">Personal Training with Certified Coach</h3>
          <p class="program-desc">
            Direct personal attention on every single repetition. Form correction, personalized weights, and guaranteed injury-free progress on our Besa Road gym floor.
          </p>
        </div>

        <div class="program-stats">
          <div class="p-stat">
            <span class="p-val">1-on-1</span>
            <span class="p-lbl">Dedicated Focus</span>
          </div>
          <div class="p-stat">
            <span class="p-val">Custom</span>
            <span class="p-lbl">Diet & Macros</span>
          </div>
        </div>

        <ul class="program-features">
          <li>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#eab308" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            <span>Full access to all Gymquip commercial stations</span>
          </li>
          <li>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#eab308" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            <span>Weekly body fat, waist & inches measurement</span>
          </li>
          <li>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#eab308" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            <span>Indian diet friendly custom meal planning</span>
          </li>
          <li>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#eab308" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            <span>Direct WhatsApp guidance and check-ins</span>
          </li>
        </ul>

        <a href="#book-call" class="btn-primary program-cta">Book Trial Session</a>
      </article>

      <!-- Tier 2: Featured -->
      <article class="program-card glass-card program-card-popular">
        <div class="popular-ribbon">RECOMMENDED</div>
        <div class="program-tier-badge badge-glow">HYPERTROPHY & RECOMP</div>
        <div class="program-top">
          <span class="program-tag tag-nexus">STRENGTH ARCHITECTURE</span>
          <h3 class="program-name">Nexus Body Recomposition</h3>
          <p class="program-desc">
            Our most popular protocol: simultaneously drop unwanted body fat while building lean shoulder, chest, arm, and leg muscular definition.
          </p>
        </div>

        <div class="program-stats">
          <div class="p-stat">
            <span class="p-val text-nexus">6 Days</span>
            <span class="p-lbl">Weekly Access</span>
          </div>
          <div class="p-stat">
            <span class="p-val text-nexus">12 Weeks</span>
            <span class="p-lbl">Recomp Cycle</span>
          </div>
        </div>

        <ul class="program-features">
          <li>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#eab308" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            <span>Heavy compound lifts mastery & spinal alignment</span>
          </li>
          <li>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#eab308" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            <span>Gymquip lever machines for targeted hypertrophy</span>
          </li>
          <li>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#eab308" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            <span>Cardio conditioning & abdominal stamina circuits</span>
          </li>
          <li>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#eab308" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            <span>Guaranteed 90-day physical progress commitment</span>
          </li>
        </ul>

        <a href="#book-call" class="btn-primary program-cta">Start Recomp Protocol</a>
      </article>

      <!-- Tier 3 -->
      <article class="program-card glass-card">
        <div class="program-tier-badge">GENERAL MEMBERSHIP</div>
        <div class="program-top">
          <span class="program-tag">ACTIVE FLOOR ACCESS</span>
          <h3 class="program-name">Unisex Gym Membership</h3>
          <p class="program-desc">
            Full floor access to Nexus Fitness Court with complete usage of custom dumbbells, barbells, benches, cardio zone, and floor trainer guidance.
          </p>
        </div>

        <div class="program-stats">
          <div class="p-stat">
            <span class="p-val">Flexible</span>
            <span class="p-lbl">Morning / Evening</span>
          </div>
          <div class="p-stat">
            <span class="p-val">Monthly</span>
            <span class="p-lbl">Or Annual Plans</span>
          </div>
        </div>

        <ul class="program-features">
          <li>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#eab308" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            <span>Full access to dumbbells, cable towers & plate racks</span>
          </li>
          <li>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#eab308" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            <span>Air-conditioned, modern interior with energetic music</span>
          </li>
          <li>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#eab308" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            <span>Floor trainer support on machine setup & safety</span>
          </li>
          <li>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#eab308" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            <span>Clean locker facility and drinking water stations</span>
          </li>
        </ul>

        <a href="#book-call" class="btn-ghost program-cta">Inquire Membership</a>
      </article>
    </div>
  </div>
</section>

<style>
  .programs-section {
    padding: 6.5rem 0;
    position: relative;
    background: #08090e;
    border-top: 1px solid var(--border-subtle);
  }
  .programs-header {
    max-width: 780px;
    margin: 0 auto 4rem auto;
  }
  .programs-title {
    font-size: 2.5rem;
    margin-top: 1.25rem;
    margin-bottom: 1rem;
  }
  @media (min-width: 768px) {
    .programs-title {
      font-size: 3.5rem;
    }
  }
  .programs-sub {
    font-size: 1.1rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .programs-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  @media (min-width: 1024px) {
    .programs-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .program-card {
    background: var(--bg-surface);
    border-radius: var(--radius-xl);
    border: 1px solid var(--border-subtle);
    padding: 2.5rem 2rem;
    display: flex;
    flex-direction: column;
    position: relative;
    transition: all var(--transition-smooth);
  }
  .program-card:hover {
    transform: translateY(-6px);
    border-color: var(--border-medium);
  }

  .program-card-popular {
    background: linear-gradient(180deg, #181b25 0%, #10121a 100%);
    border-color: var(--primary);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.7), 0 0 35px rgba(234, 179, 8, 0.2);
  }
  .popular-ribbon {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--primary);
    color: #0b0c10;
    font-family: var(--font-heading);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    padding: 0.35rem 1.1rem;
    border-radius: var(--radius-pill);
    box-shadow: 0 0 15px rgba(234, 179, 8, 0.5);
  }

  .program-tier-badge {
    font-family: var(--font-heading);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--text-dim);
    margin-bottom: 1.25rem;
  }
  .badge-glow {
    color: var(--primary);
  }

  .program-top {
    margin-bottom: 1.5rem;
  }
  .program-tag {
    font-size: 0.75rem;
    font-family: var(--font-heading);
    color: var(--text-secondary);
    letter-spacing: 0.05em;
    font-weight: 600;
  }
  .tag-nexus {
    color: var(--primary);
  }
  .program-name {
    font-size: 1.55rem;
    color: #ffffff;
    margin-top: 0.35rem;
    margin-bottom: 0.85rem;
    line-height: 1.2;
  }
  .program-desc {
    font-size: 0.92rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .program-stats {
    display: flex;
    justify-content: space-between;
    padding: 1.25rem 0;
    margin-bottom: 1.5rem;
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
  }
  .p-stat {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .p-val {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 700;
    color: #ffffff;
  }
  .p-lbl {
    font-size: 0.72rem;
    text-transform: uppercase;
    color: var(--text-dim);
    letter-spacing: 0.05em;
  }

  .program-features {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2.5rem;
    flex: 1;
  }
  .program-features li {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.45;
  }
  .program-features li span {
    flex: 1;
  }

  .program-cta {
    width: 100%;
    padding: 0.95rem 1.5rem;
    font-size: 0.88rem;
  }
</style>
